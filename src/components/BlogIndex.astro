---
import Layout from "../layouts/Layout.astro";
import PostList from "./PostList.astro";
import Subscribe from "./Subscribe.astro";
import { getPosts, categoryUrl, slugify, type Post } from "../lib/posts";

// Shared by /blog, /blog/category/*, /blog/tag/*
interface Props {
  title: string;
  heading: string;
  prompt: string;
  intro: string;
  posts: Post[];
  noindex?: boolean;
  crumb?: { name: string; url: string };
  image?: string;
}

const { title, heading, prompt, intro, posts, noindex = false, crumb, image } = Astro.props;

const categories = Object.entries(Object.groupBy(await getPosts(), (p) => p.data.category))
  .map(([name, list]) => ({ name, count: list!.length }))
  .sort((a, b) => b.count - a.count);
const current = Astro.url.pathname;

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Blog", url: "/blog/" },
  ...(crumb ? [crumb] : []),
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: title,
    description: intro,
    url: new URL(current, Astro.site).href,
    mainEntity: {
      "@type": "ItemList",
      itemListElement: posts.map((p, i) => ({ "@type": "ListItem", position: i + 1, url: new URL(`/blog/${p.id}/`, Astro.site).href })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: breadcrumbs.map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: new URL(b.url, Astro.site).href })),
  },
];
---
<Layout title={title} description={intro} noindex={noindex} jsonLd={jsonLd} image={image}>
  <div class="flex flex-col gap-8">
    <header class="flex flex-col gap-3">
      <p class="rise font-mono text-sm text-primary">{prompt}</p>
      <h1 class="rise text-4xl font-semibold sm:text-5xl" style="--d:80ms">{heading}</h1>
      <p class="rise text-muted-foreground" style="--d:160ms">{intro}</p>
    </header>
    <nav aria-label="Categories" class="rise flex flex-wrap gap-2 font-mono text-xs" style="--d:240ms">
      <a href="/blog/" class:list={["rounded-md border px-2.5 py-1 transition hover:text-primary", current === "/blog/" ? "border-primary/40 text-primary" : "text-muted-foreground"]}>all</a>
      {categories.map((c) => (
        <a href={categoryUrl(c.name)} class:list={["rounded-md border px-2.5 py-1 transition hover:text-primary", current === categoryUrl(c.name) ? "border-primary/40 text-primary" : "text-muted-foreground"]}>
          {slugify(c.name)} <span class="opacity-60">{c.count}</span>
        </a>
      ))}
    </nav>
    <PostList posts={posts} />
    <Subscribe compact />
  </div>
</Layout>
