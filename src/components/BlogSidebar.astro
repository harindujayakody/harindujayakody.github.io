---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
import { author } from "../data/author";
import { getPosts, categoryUrl, slugify } from "../lib/posts";

// Blog index sidebar. Only shown from xl up: it sits in the right margin next to the 3xl column, so small screens lose nothing.
const posts = await getPosts();
const latest = posts.slice(0, 4);
const popular = posts.filter((p) => p.data.popular).slice(0, 4);
const categories = Object.entries(Object.groupBy(posts, (p) => p.data.category))
  .map(([name, list]) => ({ name, count: list!.length }))
  .sort((a, b) => b.count - a.count);
const current = Astro.url.pathname;
const lists = [
  { label: "latest", items: latest },
  { label: "popular", items: popular },
].filter((l) => l.items.length > 0);
---
<aside aria-label="Blog sidebar" class="hidden xl:block absolute left-full top-0 ml-8 h-full w-56">
  <div class="sticky top-20 flex flex-col gap-6 text-sm">
    <section aria-label="About" class="flex flex-col gap-2 rounded-xl border bg-card/50 p-4">
      <Image src={avatar} alt="" width={40} height={40} densities={[1, 2]} quality={90} class="size-10 rounded-full ring-1 ring-border" />
      <p class="font-heading font-semibold leading-tight"><a href="/" class="hover:text-primary">{author.name}</a></p>
      <p class="text-xs leading-relaxed text-muted-foreground">{author.bio}</p>
    </section>
    {lists.map((l) => (
      <nav aria-label={`${l.label} posts`} class="flex flex-col gap-2">
        <h2 class="font-mono text-xs text-muted-foreground">$ ls --{l.label}</h2>
        <ul class="flex flex-col gap-1.5">
          {l.items.map((p) => <li><a href={`/blog/${p.id}/`} class="line-clamp-2 leading-snug text-foreground/90 hover:text-primary">{p.data.title}</a></li>)}
        </ul>
      </nav>
    ))}
    <nav aria-label="Categories" class="flex flex-col gap-2">
      <h2 class="font-mono text-xs text-muted-foreground">$ ls categories</h2>
      <ul class="flex flex-col gap-1">
        {categories.map((c) => (
          <li>
            <a href={categoryUrl(c.name)} aria-current={current === categoryUrl(c.name) ? "page" : undefined}
              class:list={["flex justify-between gap-2 hover:text-primary", current === categoryUrl(c.name) ? "text-primary" : "text-foreground/90"]}>
              <span>{slugify(c.name)}</span><span class="font-mono text-xs text-muted-foreground tabular-nums">{c.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>
