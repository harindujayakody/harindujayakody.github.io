---
// giscus: comments stored as GitHub Discussions in the site repo (Announcements category: only giscus and the owner open threads).
const repo = "harindujayakody/harindujayakody.github.io";
const config = {
  "data-repo": repo,
  "data-repo-id": "MDEwOlJlcG9zaXRvcnkyODk3NzY0MzY=",
  "data-category": "Announcements",
  "data-category-id": "DIC_kwDOEUWjNM4DLDkU",
  "data-mapping": "pathname",
  "data-strict": "1",
  "data-reactions-enabled": "1",
  "data-emit-metadata": "0",
  "data-input-position": "bottom",
  "data-lang": "en",
  // Absolute URL: giscus loads it inside its own iframe.
  "data-theme": new URL("/giscus-theme.css", Astro.site).href,
};
const discussions = `https://github.com/${repo}/discussions/categories/announcements`;
---
<section id="comments" aria-labelledby="comments-title" class="mt-16 flex flex-col gap-4">
  <h2 id="comments-title" class="reveal font-mono text-sm text-muted-foreground">$ cat comments.log</h2>
  <div class="giscus min-h-24" data-giscus={JSON.stringify(config)}>
    <button type="button" data-giscus-load
      class="rounded-md border bg-card/60 px-4 py-2 font-mono text-sm text-muted-foreground transition hover:border-foreground/25 hover:text-primary focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">
      load comments
    </button>
  </div>
  <noscript><p class="text-sm text-muted-foreground">Comments need JavaScript. You can also read and reply <a href={discussions} class="text-primary underline underline-offset-4">on GitHub Discussions</a>.</p></noscript>
</section>

<script is:inline>
  // Load giscus only when the comments come near the viewport (or on click), so readers who never scroll here pay nothing.
  (() => {
    const box = document.querySelector("[data-giscus]");
    if (!box) return;
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      io.disconnect();
      box.querySelector("[data-giscus-load]")?.remove();
      const s = document.createElement("script");
      s.src = "https://giscus.app/client.js";
      s.async = true;
      s.crossOrigin = "anonymous";
      for (const [k, v] of Object.entries(JSON.parse(box.dataset.giscus))) s.setAttribute(k, v);
      box.append(s);
    };
    const io = new IntersectionObserver((e) => e.some((x) => x.isIntersecting) && load(), { rootMargin: "600px 0px" });
    io.observe(box);
    box.querySelector("[data-giscus-load]")?.addEventListener("click", load);
  })();
</script>
