---
import type { Item } from "../data/projects";
import Badge from "./ui/Badge.astro";
import { getRepos } from "../lib/github";

interface Props {
  item: Item;
}

const { item: p } = Astro.props;
// Star count from the build-time repo list (cached per build), shown on the repo link.
const repoName = p.repo?.split("/").pop()?.toLowerCase();
const stars = repoName ? (await getRepos()).find((r) => r.name.toLowerCase() === repoName)?.stargazers_count : undefined;
---
<article class="reveal group relative flex min-w-0 flex-col gap-2 rounded-xl border bg-card/70 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-foreground/20">
  <div class="flex items-center justify-between gap-2">
    <h3 class="min-w-0 truncate font-mono text-sm font-medium group-hover:text-primary">
      <a href={p.href} target={p.href.startsWith("http") ? "_blank" : undefined} rel={p.href.startsWith("http") ? "noopener" : undefined} class="after:absolute after:inset-0">{p.name}</a>
    </h3>
    <Badge>{p.kind}</Badge>
  </div>
  <p class="text-sm leading-relaxed text-muted-foreground">{p.desc}</p>
  <div class="mt-auto flex flex-wrap items-center gap-1.5 pt-1">
    {p.tags.map((t) => <Badge variant="outline">{t}</Badge>)}
    {p.repo && (
      <a href={p.repo} target="_blank" rel="noopener" class="relative z-10 ml-auto flex items-center gap-1 font-mono text-xs text-muted-foreground hover:text-primary"
        aria-label={`${p.name} on GitHub${stars ? `, ${stars} stars` : ""}`}>
        {stars ? <><svg viewBox="0 0 24 24" fill="currentColor" class="size-3.5 text-[#e3b341]" aria-hidden="true"><path d="M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.53L12 17.5l-5.87 3.07 1.12-6.53L2.5 9.41l6.56-.95z" /></svg>{stars} · star ↗</> : "source ↗"}
      </a>
    )}
  </div>
</article>
