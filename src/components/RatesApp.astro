---
import { ratesBase } from "../data/rates";
---
<section id="rates-app" data-base={ratesBase} aria-label="Bank exchange rates" class="flex flex-col gap-5">
  <div id="ra-install" hidden class="flex flex-col gap-3 rounded-xl border bg-card/70 p-4"></div>

  <p id="ra-status" class="font-mono text-xs leading-relaxed text-muted-foreground" aria-live="polite">Loading rates…</p>

  <div class="flex flex-col gap-2">
    <div id="ra-currencies" role="group" aria-label="Currency" class="flex items-center gap-2"></div>
    <div id="ra-more-panel" hidden role="group" aria-label="More currencies" class="flex flex-wrap gap-2 rounded-xl border bg-card/50 p-3"></div>
  </div>

  <div class="grid overflow-hidden rounded-xl border bg-card/70 lg:grid-cols-[5fr_7fr]">
    <div id="ra-summary" class="flex min-w-0 flex-col gap-5 p-4 sm:gap-6 sm:p-6">
      <div class="h-9 w-64 animate-pulse rounded-md bg-muted"></div>
      <div class="h-16 w-48 animate-pulse rounded-md bg-muted"></div>
      <div class="h-24 animate-pulse rounded-md bg-muted"></div>
    </div>
    <div id="ra-chart" class="flex min-w-0 flex-col gap-4 border-t p-4 sm:p-6 lg:border-l lg:border-t-0">
      <div class="h-56 animate-pulse rounded-md bg-muted"></div>
    </div>
  </div>

  <div id="ra-table" class="overflow-hidden rounded-xl border bg-card/70"></div>

  <details id="ra-daily" class="group rounded-xl border bg-card/50">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 font-medium [&::-webkit-details-marker]:hidden">
      Daily best and worst rates
      <span aria-hidden="true" class="text-muted-foreground transition group-open:rotate-180">▾</span>
    </summary>
    <div id="ra-daily-body" class="overflow-x-auto border-t px-5 pb-4"></div>
  </details>

  <noscript><p class="text-sm text-muted-foreground">The live rates need JavaScript. They are read from a small data file that updates every 3 hours.</p></noscript>
</section>

<script>
  type Rate = { currency: string; buying: number; selling: number };
  type Bank = { id: string; name: string; short?: string; rates: Rate[]; bankUpdatedAt?: string | null; fetchedAt?: string; error?: string | null };
  type Status = { banks: Bank[]; lastRefresh: { at: string } | null; nextRefresh: string | null };
  type Snap = { at: string; rates: Record<string, [number, number]> };
  type Side = "buying" | "selling";

  const root = document.getElementById("rates-app")!;
  const base = root.dataset.base!;
  const $ = (id: string) => document.getElementById(id)!;
  const MAIN = ["USD", "EUR", "GBP", "AED"];
  const RANGES: [string, number][] = [["1D", 1], ["1W", 7], ["1M", 30], ["6M", 182], ["Max", 0]];
  const STALE_MS = 7 * 3_600_000;
  const names = new Intl.DisplayNames(["en"], { type: "currency" });

  const state = {
    status: null as Status | null,
    history: null as Snap[] | null,
    currency: new URLSearchParams(location.search).get("c")?.toUpperCase() || "USD",
    side: "selling" as Side,
    bank: "best",
    range: "1W",
    more: false,
  };

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  const num = (n: number) => n.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 4 });
  const cname = (c: string) => (c === "CNH" ? "Offshore yuan" : names.of(c) || c);
  const better = (side: Side, a: number, b: number) => (side === "buying" ? a > b : a < b);

  function ago(iso: string | null | undefined, now = Date.now()) {
    if (!iso) return "never";
    const mins = Math.round((new Date(iso).getTime() - now) / 60000);
    if (Math.abs(mins) < 1) return "just now";
    const [v, u] = Math.abs(mins) < 60 ? [mins, "minute"] : Math.abs(mins) < 2880 ? [Math.round(mins / 60), "hour"] : [Math.round(mins / 1440), "day"];
    return new Intl.RelativeTimeFormat("en", { numeric: "auto" }).format(v, u as Intl.RelativeTimeFormatUnit);
  }
  function bankClock(iso: string | null | undefined) {
    if (!iso) return "—";
    const dateOnly = iso.length === 10;
    return new Date(dateOnly ? `${iso}T00:00:00Z` : iso).toLocaleString("en-GB", {
      day: "numeric", month: "short", year: "numeric",
      ...(dateOnly ? { timeZone: "UTC" } : { hour: "numeric", minute: "2-digit", hour12: true, timeZone: "Asia/Colombo" }),
    });
  }
  const stale = (b: Bank) => !!b.error || !b.fetchedAt || Date.now() - new Date(b.fetchedAt).getTime() > STALE_MS;

  // Banks quoting the current currency, with the rate pair.
  const quotes = () =>
    (state.status?.banks ?? []).flatMap((b) => {
      const r = b.rates.find((x) => x.currency === state.currency);
      return r ? [{ bank: b, buying: r.buying, selling: r.selling }] : [];
    });
  const sorted = (side: Side) => [...quotes()].sort((a, b) => (side === "buying" ? b.buying - a.buying : a.selling - b.selling));

  const seg = (action: string, items: [string, string][], active: string, label: string) =>
    `<div role="group" aria-label="${label}" class="inline-flex rounded-md border p-0.5">${items
      .map(([v, t]) => `<button type="button" data-a="${action}" data-v="${v}" aria-pressed="${v === active}" class="h-8 rounded px-3 font-mono text-xs transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring ${v === active ? "bg-primary text-primary-foreground" : "text-muted-foreground hover:text-foreground"}">${t}</button>`)
      .join("")}</div>`;

  function renderCurrencies() {
    const all = [...new Set((state.status?.banks ?? []).flatMap((b) => b.rates.map((r) => r.currency)))].sort();
    if (!all.includes(state.currency)) state.currency = all.includes("USD") ? "USD" : all[0] ?? "USD";
    const main = MAIN.filter((c) => all.includes(c));
    const rest = all.filter((c) => !main.includes(c));
    const chip = (c: string, on: boolean) =>
      `<button type="button" data-a="currency" data-v="${c}" aria-pressed="${on}" title="${esc(cname(c))}" class="h-10 min-w-0 flex-1 rounded-md border px-2 font-mono text-sm transition-colors focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring sm:flex-none sm:px-4 ${on ? "border-primary bg-primary text-primary-foreground" : "bg-card/60 text-foreground hover:border-foreground/25"}">${c}</button>`;
    const inRest = rest.includes(state.currency);
    $("ra-currencies").innerHTML =
      main.map((c) => chip(c, c === state.currency)).join("") +
      (inRest ? chip(state.currency, true) : "") +
      (rest.length
        ? `<button type="button" data-a="more" aria-expanded="${state.more}" aria-controls="ra-more-panel" class="inline-flex h-10 shrink-0 items-center gap-1.5 rounded-md border bg-card/60 px-3 font-mono text-sm text-muted-foreground transition-colors hover:border-foreground/25 hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">${state.more ? "Less" : `+${rest.length}`}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition ${state.more ? "rotate-180" : ""}"><path d="m6 9 6 6 6-6"/></svg></button>`
        : "");
    const panel = $("ra-more-panel");
    panel.hidden = !state.more || !rest.length;
    panel.innerHTML = rest
      .filter((c) => c !== state.currency)
      .map((c) => `<button type="button" data-a="currency" data-v="${c}" aria-pressed="false" title="${esc(cname(c))}" class="h-9 rounded-md border bg-card/60 px-3 font-mono text-xs transition-colors hover:border-foreground/25 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">${c}<span class="ml-1.5 hidden font-sans text-muted-foreground sm:inline">${esc(cname(c))}</span></button>`)
      .join("");
  }

  // Points for the chart: the best rate across banks (or one bank) at each saved refresh.
  function series() {
    const out: { t: number; v: number }[] = [];
    const days = RANGES.find(([k]) => k === state.range)?.[1] ?? 0;
    const cut = days ? Date.now() - days * 86_400_000 : 0;
    for (const h of state.history ?? []) {
      const t = new Date(h.at).getTime();
      if (t < cut) continue;
      const i = state.side === "buying" ? 0 : 1;
      const vals = Object.entries(h.rates).filter(([id]) => state.bank === "best" || id === state.bank).map(([, r]) => r[i]);
      if (!vals.length) continue;
      out.push({ t, v: state.side === "buying" ? Math.max(...vals) : Math.min(...vals) });
    }
    return out;
  }

  function renderSummary() {
    const q = quotes();
    const side = state.side;
    const ranked = sorted(side);
    const pick = state.bank === "best" ? ranked[0] : q.find((x) => x.bank.id === state.bank) ?? ranked[0];
    if (!pick) { $("ra-summary").innerHTML = `<p class="text-muted-foreground">No bank quotes ${state.currency} right now.</p>`; return; }
    const value = pick[side];
    const [int, dec] = value.toFixed(2).split(".");
    const extra = String(value).split(".")[1]?.slice(2) ?? "";
    const pts = series();
    let change = "";
    if (pts.length > 1) {
      const d = pts[pts.length - 1].v - pts[0].v;
      const pct = (d / pts[0].v) * 100;
      const good = d === 0 ? null : side === "buying" ? d > 0 : d < 0;
      const cls = good === null ? "text-muted-foreground" : good ? "text-primary" : "text-[var(--danger)]";
      change = `<p class="font-mono text-sm tabular-nums ${cls}">${d >= 0 ? "+" : ""}${num(d)} (${pct >= 0 ? "+" : ""}${pct.toFixed(2)}%) <span class="text-muted-foreground">${state.range}</span></p>`;
    }
    const lowestSell = sorted("selling")[0];
    const topBuy = sorted("buying")[0];
    const spread = [...q].sort((a, b) => a.selling - a.buying - (b.selling - b.buying))[0];
    const row = (k: string, v: string, who: string) => `<div class="flex items-baseline justify-between gap-3 py-2.5"><dt class="text-sm text-muted-foreground">${k}</dt><dd class="text-right"><span class="font-mono text-sm tabular-nums">${v}</span> <span class="text-sm text-muted-foreground">${esc(who)}</span></dd></div>`;
    const options = ranked.map((x) => `<option value="${x.bank.id}" ${x.bank.id === state.bank ? "selected" : ""}>${esc(x.bank.short || x.bank.name)}</option>`).join("");
    $("ra-summary").innerHTML = `
      <div class="flex items-center gap-2">
        ${seg("side", [["selling", "Selling"], ["buying", "Buying"]], side, "Rate type")}
        <label class="sr-only" for="ra-bank">Bank</label>
        <select id="ra-bank" data-a="bank" class="h-9 min-w-0 flex-1 rounded-md border bg-card/60 px-2.5 text-sm focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring sm:flex-none"><option value="best" ${state.bank === "best" ? "selected" : ""}>Best bank</option>${options}</select>
      </div>
      <div class="flex flex-col gap-1.5">
        <p class="text-sm text-muted-foreground">${state.bank === "best" ? (side === "buying" ? "Highest buying rate" : "Lowest selling rate") : side === "buying" ? "Buying rate" : "Selling rate"} · 1 ${state.currency} <span class="hidden sm:inline">(${esc(cname(state.currency))})</span></p>
        <h2 class="text-2xl font-semibold leading-tight tracking-tight sm:text-4xl">${esc(pick.bank.name)}</h2>
        <p class="font-mono tabular-nums leading-none" aria-label="${num(value)} rupees"><span class="mr-1 text-xl text-muted-foreground">Rs</span><span class="text-5xl font-semibold tracking-tight sm:text-6xl">${int}</span><span class="text-2xl text-muted-foreground sm:text-3xl">.${dec}${extra}</span></p>
        ${change}
      </div>
      <dl class="divide-y border-y">
        ${row("Lowest selling", num(lowestSell.selling), lowestSell.bank.short || lowestSell.bank.name)}
        ${row("Highest buying", num(topBuy.buying), topBuy.bank.short || topBuy.bank.name)}
        ${row("Smallest spread", num(spread.selling - spread.buying), spread.bank.short || spread.bank.name)}
        ${row(`Banks quoting ${state.currency}`, String(q.length), "")}
      </dl>`;
  }

  function renderChart() {
    const pts = series();
    const W = 640, H = 240, L = 8, R = 56, T = 12, B = 26;
    const head = `<div class="flex flex-wrap items-center justify-between gap-2"><p class="text-sm text-muted-foreground">${state.bank === "best" ? "Best" : "Bank"} ${state.side} rate over time</p>${seg("range", RANGES.map(([k]) => [k, k]), state.range, "Range")}</div>`;
    if (!state.history) { $("ra-chart").innerHTML = head + `<div class="h-56 animate-pulse rounded-md bg-muted"></div>`; return; }
    if (pts.length < 2) {
      $("ra-chart").innerHTML = head + `<div class="flex h-56 flex-col items-center justify-center gap-1 rounded-md border border-dashed px-6 text-center"><p class="font-medium">The history line starts here.</p><p class="text-sm text-muted-foreground">A point is added every 3 hours. ${pts.length} so far in this range.</p></div>`;
      return;
    }
    const ts = pts.map((p) => p.t), vs = pts.map((p) => p.v);
    const t0 = Math.min(...ts), t1 = Math.max(...ts);
    let lo = Math.min(...vs), hi = Math.max(...vs);
    if (hi - lo < 0.5) { const m = (hi + lo) / 2; lo = m - 0.5; hi = m + 0.5; }
    const pad = (hi - lo) * 0.12; lo -= pad; hi += pad;
    const x = (t: number) => L + ((t - t0) / (t1 - t0 || 1)) * (W - L - R);
    const y = (v: number) => T + (1 - (v - lo) / (hi - lo)) * (H - T - B);
    const line = pts.map((p, i) => `${i ? "L" : "M"}${x(p.t).toFixed(1)} ${y(p.v).toFixed(1)}`).join("");
    const grid = [0, 1, 2, 3].map((i) => {
      const v = lo + ((hi - lo) * i) / 3;
      return `<line x1="${L}" x2="${W - R}" y1="${y(v).toFixed(1)}" y2="${y(v).toFixed(1)}" stroke="var(--border)" stroke-width="1" /><text x="${W - R + 8}" y="${(y(v) + 4).toFixed(1)}" fill="var(--muted-foreground)" font-size="11" font-family="var(--font-mono)">${v.toFixed(2)}</text>`;
    }).join("");
    const label = (t: number) => new Date(t).toLocaleDateString("en-GB", { day: "numeric", month: "short", timeZone: "Asia/Colombo" });
    $("ra-chart").innerHTML = head + `
      <div class="relative">
        <svg id="ra-svg" viewBox="0 0 ${W} ${H}" class="h-auto w-full touch-pan-y select-none" role="img" aria-label="${state.currency} ${state.side} rate from ${num(vs[0])} to ${num(vs[vs.length - 1])} between ${label(t0)} and ${label(t1)}">
          ${grid}
          <path d="${line}" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
          <text x="${L}" y="${H - 6}" fill="var(--muted-foreground)" font-size="11" font-family="var(--font-mono)">${label(t0)}</text>
          <text x="${W - R}" y="${H - 6}" text-anchor="end" fill="var(--muted-foreground)" font-size="11" font-family="var(--font-mono)">${label(t1)}</text>
          <line id="ra-cur" y1="${T}" y2="${H - B}" stroke="var(--muted-foreground)" stroke-dasharray="3 3" visibility="hidden" />
          <circle id="ra-dot" r="4" fill="var(--primary)" stroke="var(--card)" stroke-width="2" visibility="hidden" />
          <rect id="ra-hit" x="${L}" y="${T}" width="${W - L - R}" height="${H - T - B}" fill="transparent" />
        </svg>
        <div id="ra-tip" class="pointer-events-none absolute z-10 hidden rounded-md border bg-background px-2.5 py-1.5 font-mono text-xs shadow-sm"></div>
      </div>
      <dl class="mt-auto grid grid-cols-3 gap-4 border-t pt-4">
        ${[["Low", num(Math.min(...vs))], ["High", num(Math.max(...vs))], ["Updates", String(pts.length)]].map(([k, v]) => `<div><dt class="text-xs text-muted-foreground">${k} · ${state.range}</dt><dd class="font-mono text-sm tabular-nums">${v}</dd></div>`).join("")}
      </dl>`;
    const svg = $("ra-svg") as unknown as SVGSVGElement, tip = $("ra-tip");
    const cur = $("ra-cur"), dot = $("ra-dot");
    const move = (e: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      const px = ((e.clientX - r.left) / r.width) * W;
      const p = pts.reduce((a, b) => (Math.abs(x(b.t) - px) < Math.abs(x(a.t) - px) ? b : a));
      cur.setAttribute("x1", String(x(p.t))); cur.setAttribute("x2", String(x(p.t)));
      dot.setAttribute("cx", String(x(p.t))); dot.setAttribute("cy", String(y(p.v)));
      cur.setAttribute("visibility", "visible"); dot.setAttribute("visibility", "visible");
      tip.textContent = `${num(p.v)} · ${new Date(p.t).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "numeric", minute: "2-digit", hour12: true, timeZone: "Asia/Colombo" })}`;
      tip.classList.remove("hidden");
      const left = (x(p.t) / W) * r.width;
      tip.style.left = `${Math.min(Math.max(left, 70), r.width - 70)}px`;
      tip.style.top = "0px";
      tip.style.transform = "translateX(-50%)";
    };
    const hide = () => { cur.setAttribute("visibility", "hidden"); dot.setAttribute("visibility", "hidden"); tip.classList.add("hidden"); };
    const hit = $("ra-hit");
    hit.addEventListener("pointermove", move); hit.addEventListener("pointerleave", hide);
  }

  function renderTable() {
    const side = state.side;
    const rows = sorted(side);
    const best = rows[0];
    const head = (t: string, cls = "") => `<th scope="col" class="px-3 py-3 text-left font-mono text-xs font-normal text-muted-foreground sm:px-4 ${cls}">${t}</th>`;
    $("ra-table").innerHTML = `
      <div class="overflow-x-auto"><table class="w-full border-collapse text-sm">
        <caption class="sr-only">${state.currency} rates by bank, best ${side} rate first</caption>
        <thead class="border-b"><tr>${head("Bank")}${head("Selling", "text-right")}${head("Buying", "text-right")}${head("Spread", "hidden text-right sm:table-cell")}${head("Bank updated", "hidden md:table-cell")}</tr></thead>
        <tbody class="divide-y">${rows.map((r) => {
          const isBest = r === best;
          const old = stale(r.bank);
          const cell = (v: number, on: boolean) => `<td class="px-3 py-3 text-right font-mono tabular-nums sm:px-4 ${on ? "font-semibold text-primary" : ""}">${num(v)}</td>`;
          return `<tr class="${isBest ? "bg-primary/5" : ""}"><th scope="row" class="px-3 py-3 text-left font-medium sm:px-4"><span class="flex flex-wrap items-center gap-2">${esc(r.bank.name)}${isBest ? `<span class="rounded border border-primary/40 px-1.5 py-0.5 font-mono text-[11px] font-normal text-primary">Best</span>` : ""}${old ? `<span class="rounded border px-1.5 py-0.5 font-mono text-[11px] font-normal text-[var(--warning)]" title="This bank's rates are more than 7 hours old or its last update failed">Stale</span>` : ""}</span></th>${cell(r.selling, isBest && side === "selling")}${cell(r.buying, isBest && side === "buying")}<td class="hidden px-4 py-3 text-right font-mono tabular-nums text-muted-foreground sm:table-cell">${num(r.selling - r.buying)}</td><td class="hidden px-4 py-3 text-muted-foreground md:table-cell">${bankClock(r.bank.bankUpdatedAt)}</td></tr>`;
        }).join("")}</tbody></table></div>`;
  }

  function renderDaily() {
    const body = $("ra-daily-body");
    const hist = state.history;
    if (!hist?.length) { body.innerHTML = `<p class="py-3 text-sm text-muted-foreground">No history yet.</p>`; return; }
    const names = Object.fromEntries((state.status?.banks ?? []).map((b) => [b.id, b.short || b.name]));
    const days = new Map<string, { bb: [number, string]; wb: [number, string]; bs: [number, string]; ws: [number, string]; at: string }>();
    for (const h of hist) {
      const day = new Date(h.at).toLocaleDateString("en-CA", { timeZone: "Asia/Colombo" });
      for (const [id, [buy, sell]] of Object.entries(h.rates)) {
        const d = days.get(day) ?? { bb: [-Infinity, ""], wb: [Infinity, ""], bs: [Infinity, ""], ws: [-Infinity, ""], at: h.at };
        if (buy > d.bb[0]) d.bb = [buy, id];
        if (buy < d.wb[0]) d.wb = [buy, id];
        if (sell < d.bs[0]) d.bs = [sell, id];
        if (sell > d.ws[0]) d.ws = [sell, id];
        d.at = h.at;
        days.set(day, d);
      }
    }
    const th = (t: string, cls = "") => `<th scope="col" class="py-3 pr-4 text-left font-mono text-xs font-normal text-muted-foreground ${cls}">${t}</th>`;
    const cell = (p: [number, string], strong = false) => `<td class="py-3 pr-4 text-right font-mono tabular-nums ${strong ? "font-semibold" : "text-muted-foreground"}">${num(p[0])}<span class="block text-xs font-sans font-normal text-muted-foreground">${esc(names[p[1]] ?? p[1])}</span></td>`;
    body.innerHTML = `<table class="w-full min-w-[34rem] border-collapse text-sm"><caption class="sr-only">${state.currency} best and worst rates per day</caption><thead class="border-b"><tr>${th("Day")}${th("Best selling", "text-right")}${th("Worst selling", "text-right")}${th("Best buying", "text-right")}${th("Worst buying", "text-right")}</tr></thead><tbody class="divide-y">${
      [...days.entries()].reverse().slice(0, 14).map(([day, d]) => `<tr><th scope="row" class="py-3 pr-4 text-left font-medium">${new Date(day + "T00:00:00Z").toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", year: "numeric", timeZone: "UTC" })}</th>${cell(d.bs, true)}${cell(d.ws)}${cell(d.bb, true)}${cell(d.wb)}</tr>`).join("")
    }</tbody></table>`;
  }

  function renderStatus() {
    const s = state.status;
    $("ra-status").innerHTML = s
      ? `Updated ${ago(s.lastRefresh?.at)} · ${s.banks.length} banks<span class="hidden sm:inline"> · next update ${ago(s.nextRefresh)} · TT rates, LKR per 1 unit</span>`
      : "Loading rates…";
  }

  function renderAll() { renderStatus(); renderCurrencies(); renderSummary(); renderChart(); renderTable(); renderDaily(); }

  async function json<T>(path: string): Promise<T> {
    const res = await fetch(`${base}/${path}`, { cache: "no-cache" });
    if (!res.ok) throw new Error(String(res.status));
    return res.json();
  }

  function fail() {
    $("ra-status").textContent = "Could not load the rates.";
    $("ra-summary").innerHTML = `<div role="alert" class="flex flex-col items-start gap-3"><p class="font-medium">The rates did not load.</p><p class="text-sm text-muted-foreground">Check your connection and try again. The data refreshes every 3 hours.</p><button type="button" data-a="retry" class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/85 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">Try again</button></div>`;
  }

  async function loadHistory() {
    state.history = null;
    renderChart();
    try { state.history = await json<Snap[]>(`history/${state.currency}.json`); } catch { state.history = []; }
    renderSummary(); renderChart(); renderDaily();
  }

  async function loadStatus() {
    try {
      const prev = state.status?.lastRefresh?.at;
      state.status = await json<Status>("status.json");
      renderAll();
      if (!state.history || prev !== state.status.lastRefresh?.at) await loadHistory();
    } catch { if (!state.status) fail(); }
  }

  function setCurrency(c: string) {
    state.currency = c; state.bank = "best";
    const u = new URL(location.href);
    c === "USD" ? u.searchParams.delete("c") : u.searchParams.set("c", c);
    history.replaceState(null, "", u);
    state.more = false;
    renderCurrencies(); renderSummary(); renderTable(); loadHistory();
  }

  root.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-a]");
    if (!el) return;
    const v = el.dataset.v ?? "";
    switch (el.dataset.a) {
      case "currency": setCurrency(v); break;
      case "side": state.side = v as Side; renderSummary(); renderChart(); renderTable(); break;
      case "range": state.range = v; renderSummary(); renderChart(); break;
      case "retry": loadStatus(); break;
      case "more": state.more = !state.more; renderCurrencies(); break;
      case "install": install(); break;
      case "later": dismissInstall(); break;
      case "ios": $("ra-ios").hidden = !$("ra-ios").hidden; break;
    }
  });
  root.addEventListener("change", (e) => {
    const el = e.target as HTMLSelectElement;
    if (el.dataset.a === "currency-select" && el.value) setCurrency(el.value);
    if (el.dataset.a === "bank") { state.bank = el.value; renderSummary(); renderChart(); }
  });

  // Install as an app: Chrome and Edge offer a prompt, iPhone and iPad need Add to Home Screen.
  // Never shown once installed (or opened as an app); "Not now" hides it for 30 days.
  type Deferred = Event & { prompt: () => Promise<void>; userChoice: Promise<{ outcome: string }> };
  const IKEY = "lkr-installed", DKEY = "lkr-install-later";
  const lsGet = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const lsSet = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* private mode */ } };
  const isApp = () => matchMedia("(display-mode: standalone)").matches || (navigator as Navigator & { standalone?: boolean }).standalone === true;
  const isIos = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const phone = () => matchMedia("(max-width: 767px), (pointer: coarse)").matches;
  let deferred: Deferred | null = null;

  function renderInstall() {
    const box = $("ra-install");
    const later = Number(lsGet(DKEY) || 0);
    const hide = isApp() || lsGet(IKEY) || Date.now() - later < 30 * 86_400_000 || !phone() || !(deferred || isIos);
    box.hidden = !!hide;
    if (hide) return;
    box.innerHTML = `
      <div class="flex items-center gap-3">
        <img src="/lkr/icon-192.png" alt="" width="44" height="44" class="size-11 shrink-0 rounded-xl" />
        <div class="min-w-0 flex-1"><p class="font-medium leading-tight">Install LKR Rates</p><p class="text-sm text-muted-foreground">Open today's rates from your home screen. Works offline.</p></div>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" data-a="${deferred ? "install" : "ios"}" class="h-9 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/85 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">${deferred ? "Install" : "How to install"}</button>
        <button type="button" data-a="later" class="h-9 rounded-md px-3 text-sm text-muted-foreground transition hover:text-foreground focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">Not now</button>
      </div>
      ${deferred ? "" : `<p id="ra-ios" hidden class="text-sm leading-relaxed text-muted-foreground">Tap the Share button in Safari, then choose <span class="text-foreground">Add to Home Screen</span>.</p>`}`;
  }
  function dismissInstall() { lsSet(DKEY, String(Date.now())); $("ra-install").hidden = true; }
  async function install() {
    if (!deferred) return;
    await deferred.prompt();
    const { outcome } = await deferred.userChoice;
    deferred = null;
    if (outcome === "accepted") lsSet(IKEY, "1");
    renderInstall();
  }
  window.addEventListener("beforeinstallprompt", (e) => { e.preventDefault(); deferred = e as Deferred; renderInstall(); });
  window.addEventListener("appinstalled", () => { lsSet(IKEY, "1"); deferred = null; renderInstall(); });
  matchMedia("(display-mode: standalone)").addEventListener("change", renderInstall);
  renderInstall();

  if ("serviceWorker" in navigator) {
    navigator.serviceWorker.register("/free-tools/exchange-rates/sw.js", { scope: "/free-tools/exchange-rates/" }).catch(() => {});
  }

  loadStatus();
  setInterval(() => { if (!document.hidden) loadStatus(); }, 600_000);
  setInterval(renderStatus, 60_000);
</script>
