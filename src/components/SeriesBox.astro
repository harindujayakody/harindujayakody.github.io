---
import { seriesUrl, type Post } from "../lib/posts";

interface Props {
  name: string;
  parts: Post[];
  index: number;
}

const { name, parts, index } = Astro.props;
---
<details open class="rise rounded-xl border bg-card/50 p-4 sm:p-5" style="--d:200ms">
  <summary class="cursor-pointer font-mono text-xs text-muted-foreground select-none hover:text-foreground">
    series · <span class="text-primary">part {index + 1} of {parts.length}</span> · {name}
  </summary>
  <nav aria-label={`Series: ${name}`} class="mt-3 flex flex-col gap-3">
    <ol class="flex flex-col gap-1 text-sm">
      {parts.map((p, i) => (
        <li class="flex gap-3">
          <span class="w-5 shrink-0 text-right font-mono text-xs leading-6 text-muted-foreground">{i + 1}.</span>
          {i === index
            ? <span aria-current="page" class="font-medium text-primary">{p.data.title}</span>
            : <a href={`/blog/${p.id}/`} class="text-foreground/90 transition hover:text-primary">{p.data.title}</a>}
        </li>
      ))}
    </ol>
    <a href={seriesUrl(name)} class="self-start font-mono text-xs text-muted-foreground hover:text-primary">view the whole series →</a>
  </nav>
</details>
