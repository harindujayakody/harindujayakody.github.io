---
import { getRepos } from "../lib/github";

interface Props {
  repo: string; // "owner/name"
  compact?: boolean; // small button for the top of tool pages
  class?: string;
}

const { repo, compact = false, class: className } = Astro.props;
const [owner, name] = repo.split("/");
// Star counts come from the build-time repo list (refreshed by the daily rebuild); no request reaches visitors.
const data = (await getRepos()).find((r) => r.name.toLowerCase() === name.toLowerCase() && owner.toLowerCase() === "harindujayakody");
const href = `https://github.com/${owner}/${name}`;
// Hide a zero count: an empty-looking repo discourages the first star.
const stars = data?.stargazers_count || undefined;
const fmt = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}k` : String(n));
const GH = "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const STAR = "M12 2.5l2.94 5.96 6.56.95-4.75 4.63 1.12 6.53L12 17.5l-5.87 3.07 1.12-6.53L2.5 9.41l6.56-.95z";
---
{compact ? (
  <a href={href} target="_blank" rel="noopener" class:list={["star-btn group self-start", className]} aria-label={`Star ${name} on GitHub${stars !== undefined ? `, ${stars} stars` : ""}`}>
    <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true"><path d={GH} /></svg>
    <span class="flex items-center gap-1">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="star-icon size-3.5" aria-hidden="true"><path d={STAR} /></svg>
      Star
    </span>
    {stars !== undefined && <span class="star-count" aria-hidden="true">{fmt(stars)}</span>}
  </a>
) : (
  <aside aria-label="Open source on GitHub" class:list={["reveal flex flex-col gap-3 rounded-xl border bg-card/70 p-5 sm:flex-row sm:items-center sm:gap-5", className]}>
    <div class="flex min-w-0 flex-1 items-start gap-3">
      <svg viewBox="0 0 24 24" fill="currentColor" class="mt-0.5 size-6 shrink-0" aria-hidden="true"><path d={GH} /></svg>
      <div class="min-w-0">
        <p class="font-mono text-xs text-muted-foreground">open source</p>
        <p class="truncate font-mono text-sm font-medium"><a href={href} target="_blank" rel="noopener" class="hover:text-primary">{owner}/<span class="text-foreground">{name}</span></a></p>
        {data?.description && <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">{data.description}</p>}
        <p class="mt-1 text-sm text-muted-foreground">If it helped you, a star helps other people find it.</p>
      </div>
    </div>
    <a href={href} target="_blank" rel="noopener" class="star-btn group self-start sm:self-center" aria-label={`Star ${name} on GitHub${stars !== undefined ? `, ${stars} stars` : ""}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" class="star-icon size-4" aria-hidden="true"><path d={STAR} /></svg>
      Star on GitHub
      {stars !== undefined && <span class="star-count" aria-hidden="true">{fmt(stars)}</span>}
    </a>
  </aside>
)}
