---
import { author } from "../data/author";

interface Props {
  // Compact: one line for list pages; full: the card after each post.
  compact?: boolean;
}

const { compact = false } = Astro.props;
const id = compact ? "subscribe-email-compact" : "subscribe-email";
---
<section aria-labelledby={`${id}-title`} class:list={["reveal rounded-xl border bg-card/50", compact ? "p-4" : "p-5"]}>
  <p id={`${id}-title`} class="font-mono text-sm text-primary">$ subscribe --email</p>
  {!compact && (
    <p class="mt-2 text-sm leading-relaxed text-foreground/90">
      New posts in your inbox: AI coding tools, Windows fixes and the setups I actually use. No spam, unsubscribe anytime.
    </p>
  )}
  {/* Plain HTML form straight to Buttondown, so it works without JavaScript; its confirmation page opens in a new tab. */}
  <form action={`https://buttondown.com/api/emails/embed-subscribe/${author.newsletter}`} method="post" target="_blank"
    class="mt-3 flex flex-col gap-2 sm:flex-row">
    <label for={id} class="sr-only">Email address</label>
    <input id={id} type="email" name="email" required autocomplete="email" inputmode="email" placeholder="you@example.com"
      class="h-10 min-w-0 flex-1 rounded-md border bg-background/60 px-3 font-mono text-sm text-foreground placeholder:text-muted-foreground/70 focus-visible:border-primary/50 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring" />
    <input type="hidden" name="embed" value="1" />
    <button type="submit"
      class="h-10 shrink-0 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition hover:bg-primary/85 focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring">
      Subscribe
    </button>
  </form>
  {compact && <p class="mt-2 font-mono text-xs text-muted-foreground">New posts by email. No spam, unsubscribe anytime.</p>}
</section>
