---
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
}

// Top-level sections only: sub-headings made long posts' TOC 30+ lines. Each ## and ### still has its own # link.
const items = Astro.props.headings.filter((h) => h.depth === 2);
// Short posts don't need one; long ones start collapsed so the article stays near the top.
const show = items.length >= 3;
const open = items.length <= 6;
---
{show && (
  <details open={open} class="toc rise group rounded-xl border bg-card/50" style="--d:220ms">
    <summary class="flex list-none cursor-pointer items-center justify-between gap-3 px-4 py-3 font-mono text-xs text-muted-foreground select-none hover:text-foreground sm:px-5 [&::-webkit-details-marker]:hidden">
      <span>on this page <span class="opacity-60">· {items.length} sections</span></span>
      <span aria-hidden="true" class="transition group-open:rotate-180">▾</span>
    </summary>
    <nav aria-label="On this page" class="border-t px-4 py-3 sm:px-5">
      <ol class:list={["text-sm", items.length > 6 && "sm:columns-2 sm:gap-8"]}>
        {items.map((h, i) => (
          <li class="break-inside-avoid">
            <a href={`#${h.slug}`} class="flex gap-3 rounded-md py-1 text-foreground/90 transition hover:text-primary">
              <span class="w-5 shrink-0 font-mono text-xs leading-5 text-muted-foreground tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <span class="min-w-0 truncate">{h.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}
