---
const { variant = "secondary" } = Astro.props;
---
<span
  class:list={[
    "inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-xs font-medium",
    variant === "outline" ? "text-foreground" : "border-transparent bg-secondary text-muted-foreground",
  ]}
>
  <slot />
</span>
