---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import Toc from "../../components/Toc.astro";
import PostNav from "../../components/PostNav.astro";
import SeriesBox from "../../components/SeriesBox.astro";
import Comments from "../../components/Comments.astro";
import Subscribe from "../../components/Subscribe.astro";
import { authorJsonLd } from "../../data/author";
import { getPosts, fmtDate, readingTime, categoryUrl, tagUrl, relatedPosts, seriesOf, seriesUrl, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  // posts are newest first, so the next index is the older post.
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, related: relatedPosts(post, posts), newer: posts[i - 1], older: posts[i + 1], series: seriesOf(post, posts) },
  }));
}

const { post, related, newer, older, series }: {
  post: Post; related: Post[]; newer?: Post; older?: Post; series?: ReturnType<typeof seriesOf>;
} = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
// Social networks reject SVG, and Astro won't rasterize it: SVG covers fall back to the default card.
// A raster cover becomes the share image; otherwise (no cover, or SVG, which platforms reject) the generated card.
const og = d.image && d.image.format !== "svg" ? (await getImage({ src: d.image, width: 1200, height: 675, format: "jpg" })).src : `/og/${post.id}.png`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: url,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    articleSection: d.category,
    keywords: d.tags.join(", "),
    wordCount: post.body?.split(/\s+/).length,
    image: new URL(og, Astro.site).href,
    author: authorJsonLd(Astro.site!),
    publisher: { "@id": authorJsonLd(Astro.site!)["@id"] },
    ...(series && {
      position: series.index + 1,
      isPartOf: { "@type": "CreativeWorkSeries", name: series.name, url: new URL(seriesUrl(series.name), Astro.site).href },
    }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { name: "Home", item: "/" },
      { name: "Blog", item: "/blog/" },
      { name: d.category, item: categoryUrl(d.category) },
      { name: d.title, item: `/blog/${post.id}/` },
    ].map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: new URL(b.item, Astro.site).href })),
  },
];
---
<Layout title={`${d.title} · Harindu Jayakody`} description={d.description} image={og} type="article"
  published={d.date} modified={d.updated ?? d.date} jsonLd={jsonLd}>
  <div class="read-progress" aria-hidden="true"></div>
  <article class="flex flex-col gap-8">
    <header class="flex flex-col gap-4">
      <nav aria-label="Breadcrumb" class="rise flex flex-wrap items-center gap-1.5 font-mono text-sm text-muted-foreground">
        <a href="/blog/" class="hover:text-primary">blog</a>
        <span>/</span>
        <a href={categoryUrl(d.category)} class="text-primary hover:underline">{d.category.toLowerCase()}</a>
      </nav>
      <h1 class="rise text-3xl font-semibold leading-tight sm:text-5xl" style="--d:80ms">{d.title}</h1>
      <div class="rise flex flex-wrap items-center gap-2 font-mono text-xs text-muted-foreground" style="--d:160ms">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.updated && <span>· updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></span>}
        <span>·</span>
        <span>{readingTime(post.body)} min read</span>
        {d.tags.map((t) => (
          <a href={tagUrl(t)} class="rounded-md bg-secondary px-2 py-0.5 hover:text-primary">#{t}</a>
        ))}
      </div>
    </header>
    {d.image && (
      <Image src={d.image} alt={d.imageAlt} widths={[400, 768, 1200]} sizes="(min-width: 768px) 736px, 100vw"
        loading="eager" fetchpriority="high" class="rise aspect-video w-full rounded-xl border object-cover" style="--d:200ms" />
    )}
    {series && <SeriesBox name={series.name} parts={series.parts} index={series.index} />}
    <Toc headings={headings} />
    <div class="prose rise" style="--d:240ms"><Content /></div>
    <AuthorBox />
    <Subscribe />
  </article>

  {series && (
    <PostNav older={series.parts[series.index - 1]} newer={series.parts[series.index + 1]} label={`${series.name}: previous and next part`}
      olderText="← previous part" newerText="next part →" />
  )}
  <PostNav older={older} newer={newer} class={series ? "mt-3" : undefined} />

  {d.comments && <Comments />}

  {related.length > 0 && (
    <section class="mt-20 flex flex-col gap-5">
      <h2 class="reveal font-mono text-sm text-muted-foreground">$ ls ../related</h2>
      <PostList posts={related} />
    </section>
  )}

  {post.body?.includes("```") && (
    <script is:inline>
      // Copy button on every code block; only shipped on posts that have code.
      document.querySelectorAll(".prose pre").forEach((pre) => {
        const wrap = document.createElement("div");
        wrap.className = "code-block";
        pre.replaceWith(wrap);
        wrap.append(pre);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.textContent = "copy";
        btn.setAttribute("aria-label", "Copy code");
        btn.setAttribute("aria-live", "polite");
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText((pre.querySelector("code") ?? pre).textContent);
            btn.textContent = "copied ✓";
          } catch {
            btn.textContent = "press Ctrl+C";
          }
          setTimeout(() => (btn.textContent = "copy"), 1600);
        });
        wrap.append(btn);
      });
    </script>
  )}
</Layout>
