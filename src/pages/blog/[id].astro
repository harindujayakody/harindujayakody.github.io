---
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import PostList from "../../components/PostList.astro";
import AuthorBox from "../../components/AuthorBox.astro";
import TocSidebar from "../../components/TocSidebar.astro";
import Toc from "../../components/Toc.astro";
import PostNav from "../../components/PostNav.astro";
import SeriesBox from "../../components/SeriesBox.astro";
import Comments from "../../components/Comments.astro";
import HelpfulVote from "../../components/HelpfulVote.astro";
import Subscribe from "../../components/Subscribe.astro";
import StarCard from "../../components/StarCard.astro";
import NicDecoder from "../../components/NicDecoder.astro";
import { freeTools } from "../../data/free-tools";
import { pageMeta, isPreviewHost } from "../../lib/link-meta";
import { authorJsonLd } from "../../data/author";
import { getPosts, fmtDate, readingTime, categoryUrl, tagUrl, relatedPosts, seriesOf, seriesUrl, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  // posts are newest first, so the next index is the older post.
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: { post, related: relatedPosts(post, posts), newer: posts[i - 1], older: posts[i + 1], series: seriesOf(post, posts) },
  }));
}

const { post, related, newer, older, series }: {
  post: Post; related: Post[]; newer?: Post; older?: Post; series?: ReturnType<typeof seriesOf>;
} = Astro.props;
const { Content, headings } = await render(post);
// Link previews: links in the post to this site's pages, GitHub and kathaarana.com. Internal pages come from the content
// collections; the rest is read from the page's own title and description at build time (see lib/link-meta.ts).
const allPosts = await getPosts();
const previews: Record<string, { title: string; desc: string; img: string }> = {};
const hrefs = new Set<string>();
for (const m of (post.body ?? "").matchAll(/\]\(([^)\s]+)\)|href="([^"]+)"|<(https?:\/\/[^>\s]+)>/g)) hrefs.add(m[1] ?? m[2] ?? m[3]);
for (const href of hrefs) {
  let u: URL;
  try { u = new URL(href, Astro.site); } catch { continue; }
  const local = u.hostname.replace(/^www\./, "") === new URL(Astro.site!).hostname ? u.pathname : "";
  const p = allPosts.find((x) => local === `/blog/${x.id}/`);
  const t = freeTools.find((x) => x.href === local);
  if (p) previews[href] = { title: p.data.title, desc: p.data.description, img: `/og/${p.id}.png` };
  else if (t) previews[href] = { title: t.name, desc: t.desc, img: `/og/free-tools/${t.slug}.png` };
  else if (/^https?:/.test(href) && isPreviewHost(u)) {
    const meta = await pageMeta(u.href);
    if (meta) previews[href] = meta;
  }
}
const d = post.data;
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
// Social networks reject SVG, and Astro won't rasterize it: SVG covers fall back to the default card.
// A raster cover becomes the share image; otherwise (no cover, or SVG, which platforms reject) the generated card.
const og = d.image && d.image.format !== "svg" ? (await getImage({ src: d.image, width: 1200, height: 675, format: "jpg" })).src : `/og/${post.id}.png`;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: url,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    articleSection: d.category,
    keywords: d.tags.join(", "),
    wordCount: post.body?.split(/\s+/).length,
    image: new URL(og, Astro.site).href,
    author: authorJsonLd(Astro.site!),
    publisher: { "@id": authorJsonLd(Astro.site!)["@id"] },
    ...(series && {
      position: series.index + 1,
      isPartOf: { "@type": "CreativeWorkSeries", name: series.name, url: new URL(seriesUrl(series.name), Astro.site).href },
    }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { name: "Home", item: "/" },
      { name: "Blog", item: "/blog/" },
      { name: d.category, item: categoryUrl(d.category) },
      { name: d.title, item: `/blog/${post.id}/` },
    ].map((b, i) => ({ "@type": "ListItem", position: i + 1, name: b.name, item: new URL(b.item, Astro.site).href })),
  },
];
---
<Layout title={`${d.title} · Harindu Jayakody`} description={d.description} image={og} type="article"
  published={d.date} modified={d.updated ?? d.date} jsonLd={jsonLd}>
  <div class="read-progress" aria-hidden="true"></div>
  <article class="relative flex flex-col gap-8">
    <TocSidebar headings={headings} />
    <header class="flex flex-col gap-4">
      <nav aria-label="Breadcrumb" class="rise flex flex-wrap items-center gap-1.5 font-mono text-sm text-muted-foreground">
        <a href="/blog/" class="hover:text-primary">blog</a>
        <span>/</span>
        <a href={categoryUrl(d.category)} class="text-primary hover:underline">{d.category.toLowerCase()}</a>
      </nav>
      <h1 class="rise text-3xl font-semibold leading-tight sm:text-5xl" style="--d:80ms">{d.title}</h1>
      <div class="rise flex flex-wrap items-center gap-2 font-mono text-xs text-muted-foreground" style="--d:160ms">
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.updated && <span>· updated <time datetime={d.updated.toISOString()}>{fmtDate(d.updated)}</time></span>}
        <span>·</span>
        <span>{readingTime(post.body)} min read</span>
        {d.tags.map((t) => (
          <a href={tagUrl(t)} class="rounded-md bg-secondary px-2 py-0.5 hover:text-primary">#{t}</a>
        ))}
      </div>
    </header>
    {d.image && (
      <Image src={d.image} alt={d.imageAlt} widths={[400, 768, 1200]} sizes="(min-width: 768px) 736px, 100vw"
        loading="eager" fetchpriority="high" class="rise aspect-video w-full rounded-xl border object-cover" style="--d:200ms" />
    )}
    {!d.image && (
      <img src={`/og/${post.id}.png`} alt="" width="1200" height="630" loading="eager" fetchpriority="high"
        class="rise aspect-video w-full rounded-xl border object-cover" style="--d:200ms" />
    )}
    {series && <SeriesBox name={series.name} parts={series.parts} index={series.index} />}
    <Toc headings={headings} />
    <div class="prose rise" style="--d:240ms"><Content /></div>
    {d.repo && <StarCard repo={d.repo} />}
    <HelpfulVote id={post.id} />
    <AuthorBox />
    <Subscribe />
  </article>

  {series && (
    <PostNav older={series.parts[series.index - 1]} newer={series.parts[series.index + 1]} label={`${series.name}: previous and next part`}
      olderText="← previous part" newerText="next part →" />
  )}
  <PostNav older={older} newer={newer} class={series ? "mt-3" : undefined} />

  {d.comments && <Comments />}

  {related.length > 0 && (
    <section class="mt-20 flex flex-col gap-5">
      <h2 class="reveal font-mono text-sm text-muted-foreground">$ ls ../related</h2>
      <PostList posts={related} />
    </section>
  )}

  {/* Tools embedded in Markdown with <div data-nic-decoder></div> get their script. */}
  {post.body?.includes("data-nic-decoder") && <NicDecoder mount={false} />}

  {Object.keys(previews).length > 0 && (
    <script is:inline define:vars={{ previews }}>
      // Hover or focus a link inside the article to this site, GitHub or kathaarana.com: a small card shows its title, description and image.
      (() => {
        let card, timer;
        const hide = () => { clearTimeout(timer); card?.remove(); card = null; };
        const show = (a, p) => {
          hide();
          card = document.createElement("div");
          card.className = "link-preview";
          card.setAttribute("role", "tooltip");
          const img = document.createElement("img");
          if (p.img) { img.src = p.img; img.alt = ""; img.width = 1200; img.height = 630; }
          const t = document.createElement("strong"); t.textContent = p.title;
          const d = document.createElement("span"); d.textContent = p.desc;
          if (p.img) card.append(img);
          card.append(t, d);
          document.body.append(card);
          const r = a.getBoundingClientRect();
          const w = card.offsetWidth;
          card.style.left = Math.max(8, Math.min(innerWidth - w - 8, r.left + scrollX)) + "px";
          const below = r.bottom + card.offsetHeight + 12 < innerHeight;
          card.style.top = (below ? r.bottom + scrollY + 8 : r.top + scrollY - card.offsetHeight - 8) + "px";
        };
        document.querySelectorAll(".prose a[href]").forEach((a) => {
          const h = a.getAttribute("href");
          const p = previews[h] || previews[h.split("#")[0]];
          if (!p) return;
          a.addEventListener("mouseenter", () => { clearTimeout(timer); timer = setTimeout(() => show(a, p), 250); });
          a.addEventListener("focus", () => show(a, p));
          for (const e of ["mouseleave", "blur"]) a.addEventListener(e, hide);
        });
        addEventListener("keydown", (e) => e.key === "Escape" && hide());
      })();
    </script>
  )}

  {post.body?.includes("```") && (
    <script is:inline>
      // Copy button on every code block; only shipped on posts that have code.
      document.querySelectorAll(".prose pre").forEach((pre) => {
        const wrap = document.createElement("div");
        wrap.className = "code-block";
        pre.replaceWith(wrap);
        wrap.append(pre);
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "copy-btn";
        btn.textContent = "copy";
        btn.setAttribute("aria-label", "Copy code");
        btn.setAttribute("aria-live", "polite");
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText((pre.querySelector("code") ?? pre).textContent);
            btn.textContent = "copied ✓";
          } catch {
            btn.textContent = "press Ctrl+C";
          }
          setTimeout(() => (btn.textContent = "copy"), 1600);
        });
        wrap.append(btn);
      });
    </script>
  )}
</Layout>
