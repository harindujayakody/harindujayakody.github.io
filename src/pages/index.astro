---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { items } from "../data/projects";
import Socials from "../components/Socials.astro";
import PostList from "../components/PostList.astro";
import Timeline from "../components/Timeline.astro";
import { getRepos } from "../lib/github";
import { getPosts } from "../lib/posts";
import XFeed from "../components/XFeed.astro";
import { getXPosts } from "../lib/x";
import { xPosts } from "../data/x-posts";

const gh = "https://github.com/harindujayakody";
const [repos, posts, tweets] = await Promise.all([getRepos(), getPosts(), getXPosts(xPosts)]);

const stats = [
  { value: repos.length || "70+", label: "public repos" },
  { value: repos.reduce((n, r) => n + r.stargazers_count, 0) || "—", label: "stars earned" },
  { value: `${new Date().getFullYear() - 2014}y`, label: "on GitHub" },
];

const stack = ["TypeScript", "Astro", "Next.js", "Node.js", "PHP", "Python", "PowerShell", "Bash", "Chrome Extensions"];

const site = Astro.site!.href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: site,
    mainEntity: {
      "@type": "Person",
      "@id": `${site}#person`,
      name: "Harindu Jayakody",
      url: site,
      image: new URL("/avatar.png", site).href,
      email: "mailto:me@harindujayakody.com",
      jobTitle: "Founder",
      worksFor: { "@type": "Organization", name: "Infiax", url: "https://infiax.com" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Wrexham University" },
      address: { "@type": "PostalAddress", addressCountry: "LK" },
      knowsAbout: stack,
      sameAs: ["https://github.com/harindujayakody", "https://x.com/harindu522", "https://www.linkedin.com/in/harindux/"],
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Harindu Jayakody",
    url: site,
    author: { "@id": `${site}#person` },
    potentialAction: { "@type": "SearchAction", target: `${site}search/?q={search_term_string}`, "query-input": "required name=search_term_string" },
  },
];
---
<Layout jsonLd={jsonLd}>
  <div class="flex flex-col gap-20">
    <section class="flex flex-col gap-6">
      <div class="rise flex items-center gap-4" style="--d:0ms">
        <img src="/avatar.png" alt="Harindu Jayakody" width="56" height="56" class="size-14 rounded-full ring-1 ring-border ring-offset-4 ring-offset-background" />
        <p class="font-mono text-sm text-muted-foreground">
          <span class="text-primary">~/harindu</span> <span class="text-accent">$</span> whoami<span class="caret ml-0.5 inline-block h-4 w-2 translate-y-0.5 bg-primary" />
        </p>
      </div>
      <h1 class="rise text-4xl font-semibold leading-[1.1] sm:text-6xl" style="--d:80ms">
        Harindu Jayakody<span class="text-primary">.</span>
      </h1>
      <p class="rise max-w-xl text-lg leading-relaxed text-muted-foreground" style="--d:160ms">
        Founder of <a href="https://infiax.com" class="text-foreground underline decoration-primary underline-offset-4 hover:text-primary">Infiax</a>. I build full-stack web apps, browser extensions and small tools that automate the boring parts. Studying at Wrexham University, based in Sri Lanka.
      </p>
      <div class="rise flex flex-wrap items-center gap-2" style="--d:240ms">
        <Button href="mailto:me@harindujayakody.com">Get in touch</Button>
        <Button href={gh} variant="outline" target="_blank" rel="noopener">GitHub</Button>
        <Socials />
      </div>
    </section>

    <section aria-label="Stats" class="rise grid grid-cols-3 divide-x rounded-xl border bg-card/50" style="--d:320ms">
      {stats.map((s) => (
        <div class="flex flex-col gap-1 p-4 sm:p-5">
          <span class="font-mono text-2xl font-semibold tabular-nums sm:text-3xl">{s.value}</span>
          <span class="font-mono text-[11px] text-muted-foreground sm:text-xs">{s.label}</span>
        </div>
      ))}
    </section>

    <section class="flex flex-col gap-5">
      <div class="reveal flex items-baseline justify-between">
        <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">01</span> Projects</h2>
        <a href="/projects/" class="font-mono text-sm text-muted-foreground hover:text-primary">all projects →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {items.filter((i) => i.featured).map((item) => <ProjectCard item={item} />)}
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <div class="reveal flex items-baseline justify-between">
        <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">02</span> Writing</h2>
        <a href="/blog/" class="font-mono text-sm text-muted-foreground hover:text-primary">all posts →</a>
      </div>
      <PostList posts={posts.slice(0, 3)} />
    </section>

    <section class="flex flex-col gap-5">
      <div class="reveal flex items-baseline justify-between">
        <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">03</span> Recently shipped</h2>
        <a href="/timeline/" class="font-mono text-sm text-muted-foreground hover:text-primary">full timeline →</a>
      </div>
      <Timeline repos={repos.slice(0, 6)} />
    </section>

    <section class="reveal flex flex-col gap-5">
      <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">04</span> Stack</h2>
      <div class="flex flex-wrap gap-2">
        {stack.map((t) => <Badge variant="outline">{t}</Badge>)}
      </div>
    </section>

    {tweets.length > 0 && (
      <section class="flex flex-col gap-5">
        <div class="reveal flex items-baseline justify-between">
          <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">05</span> On X</h2>
          <a href="https://x.com/harindu522" target="_blank" rel="noopener" class="font-mono text-sm text-muted-foreground hover:text-primary">@harindu522 →</a>
        </div>
        <XFeed posts={tweets} />
      </section>
    )}
  </div>
</Layout>
