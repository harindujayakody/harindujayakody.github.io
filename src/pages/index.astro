---
import { Image } from "astro:assets";
// Same file as public/avatar.png: this copy gets a hashed, long-cacheable WebP; public/ keeps a fixed URL for social cards.
import avatar from "../assets/avatar.png";
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/Button.astro";
import Badge from "../components/ui/Badge.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { items } from "../data/projects";
import { author, authorJsonLd } from "../data/author";
import Socials from "../components/Socials.astro";
import PostList from "../components/PostList.astro";
import Timeline from "../components/Timeline.astro";
import ContributionGraph from "../components/ContributionGraph.astro";
import { getRepos, getContributions } from "../lib/github";
import { getPosts } from "../lib/posts";
import XFeed from "../components/XFeed.astro";
import { getXPosts } from "../lib/x";
import { xPosts } from "../data/x-posts";

const gh = "https://github.com/harindujayakody";
const [repos, posts, tweets, contributions] = await Promise.all([getRepos(), getPosts(), getXPosts(xPosts), getContributions()]);

// Hand-picked items and public repos overlap (most items are repos), so count unique names.
const shipped = new Set([...items, ...repos].map((x) => x.name.toLowerCase())).size;
const stats = [
  { value: posts.length, label: "posts published", href: "/blog/" },
  { value: shipped, label: "tools & projects", href: "/projects/" },
  { value: new Date().getFullYear() - 2014, label: "years building", href: "/timeline/" },
];

const stack = ["TypeScript", "Astro", "Next.js", "Node.js", "PHP", "Python", "PowerShell", "Bash", "Chrome Extensions"];

const site = Astro.site!.href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    url: site,
    mainEntity: {
      ...authorJsonLd(Astro.site!),
      email: `mailto:${author.email}`,
      jobTitle: "Founder",
      worksFor: { "@type": "Organization", name: "Infiax", url: "https://infiax.com" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Wrexham University" },
      address: { "@type": "PostalAddress", addressCountry: "LK" },
      knowsAbout: stack,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Harindu Jayakody",
    url: site,
    author: { "@id": `${site}#person` },
    potentialAction: { "@type": "SearchAction", target: `${site}search/?q={search_term_string}`, "query-input": "required name=search_term_string" },
  },
];
---
<Layout jsonLd={jsonLd}>
  <div class="flex flex-col gap-20">
    <section class="flex flex-col gap-6">
      <div class="rise flex items-center gap-4" style="--d:0ms">
        <Image src={avatar} alt="Harindu Jayakody" width={56} height={56} densities={[1, 2]} quality={90} loading="eager" class="size-14 rounded-full ring-1 ring-border ring-offset-4 ring-offset-background" />
        <p class="font-mono text-sm text-muted-foreground">
          <span class="text-primary">~/harindu</span> <span class="text-accent">$</span> whoami<span class="caret ml-0.5 inline-block h-4 w-2 translate-y-0.5 bg-primary" />
        </p>
      </div>
      <h1 class="rise text-4xl font-semibold leading-[1.1] sm:text-6xl" style="--d:80ms">
        Harindu Jayakody<span class="text-primary">.</span>
      </h1>
      <p class="rise max-w-xl text-lg leading-relaxed text-muted-foreground" style="--d:160ms">
        Founder of <a href="https://infiax.com" class="text-foreground underline decoration-primary underline-offset-4 hover:text-primary">Infiax</a>. I build full-stack web apps, browser extensions and small tools that automate the boring parts. Studying at Wrexham University, based in Sri Lanka.
      </p>
      <div class="rise flex flex-wrap items-center gap-2" style="--d:240ms">
        <Button href="mailto:me@harindujayakody.com">Get in touch</Button>
        <Button href={gh} variant="outline" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          GitHub
        </Button>
        <Socials />
      </div>
    </section>

    <section aria-label="Stats" class="rise grid grid-cols-3 divide-x rounded-xl border bg-card/50" style="--d:320ms">
      {stats.map((s) => (
        <a href={s.href} class="group flex flex-col gap-1 p-4 transition first:rounded-l-xl last:rounded-r-xl hover:bg-card focus-visible:outline-none focus-visible:ring-[3px] focus-visible:ring-ring sm:p-5">
          <span class="font-mono text-2xl font-semibold tabular-nums group-hover:text-primary sm:text-3xl">{s.value}</span>
          <span class="font-mono text-[11px] text-muted-foreground sm:text-xs">{s.label} <span class="opacity-0 transition group-hover:opacity-100" aria-hidden="true">→</span></span>
        </a>
      ))}
    </section>

    {contributions && <ContributionGraph calendar={contributions} />}

    <section class="flex flex-col gap-5">
      <div class="reveal flex items-baseline justify-between">
        <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">01</span> Projects</h2>
        <a href="/projects/" class="font-mono text-sm text-muted-foreground hover:text-primary">all projects →</a>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {items.filter((i) => i.featured).map((item) => <ProjectCard item={item} />)}
      </div>
    </section>

    <section class="flex flex-col gap-5">
      <div class="reveal flex items-baseline justify-between">
        <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">02</span> Writing</h2>
        <a href="/blog/" class="font-mono text-sm text-muted-foreground hover:text-primary">all posts →</a>
      </div>
      <PostList posts={posts.slice(0, 3)} />
    </section>

    <section class="flex flex-col gap-5">
      <div class="reveal flex items-baseline justify-between">
        <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">03</span> Recently shipped</h2>
        <a href="/timeline/" class="font-mono text-sm text-muted-foreground hover:text-primary">full timeline →</a>
      </div>
      <Timeline repos={repos.slice(0, 6)} />
    </section>

    <section class="reveal flex flex-col gap-5">
      <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">04</span> Stack</h2>
      <div class="flex flex-wrap gap-2">
        {stack.map((t) => <Badge variant="outline">{t}</Badge>)}
      </div>
    </section>

    {tweets.length > 0 && (
      <section class="flex flex-col gap-5">
        <div class="reveal flex items-baseline justify-between">
          <h2 class="flex items-center gap-3 text-xl font-semibold"><span class="font-mono text-sm text-primary">05</span> On X</h2>
          <a href="https://x.com/harindu522" target="_blank" rel="noopener" class="font-mono text-sm text-muted-foreground hover:text-primary">@harindu522 →</a>
        </div>
        <XFeed posts={tweets} />
      </section>
    )}
  </div>
</Layout>
